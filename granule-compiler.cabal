cabal-version:  3.4
name:           granule-compiler
version:        0.9.5.0
synopsis:       The Granule LLVM compiler
homepage:       https://github.com/granule-project/granule-compiler-llvm#readme
bug-reports:    https://github.com/granule-project/granule-compiler-llvm/issues
author:         Ed Brown, Dominic Orchard, Vilem-Benjamin Liepelt, Harley Eades III, Preston Keel
maintainer:     Ed Brown, Dominic Orchard, Vilem-Benjamin Liepelt, Harley Eades III, Preston Keel
copyright:      2018-2024 authors
license:        BSD-3-Clause
build-type:     Simple

common shared
  default-language: Haskell2010
  default-extensions:
      LambdaCase
      RecordWildCards
      ImplicitParams
      ScopedTypeVariables
      OverloadedStrings
  build-depends:
      base >=4.10 && <5
    , granule:frontend
    , hashable
    , prettyprinter ==1.7.1
  ghc-options:
     -O0
     -Wall
     -Werror
     -Wcompat
     -Wredundant-constraints
     -Wno-unused-matches
     -Wno-name-shadowing
     -Wno-type-defaults
     -fmax-pmcheck-models=10000000

source-repository head
  type: git
  location: https://github.com/granule-project/granule-compiler-llvm

library
  import: shared
  exposed-modules:
      Language.Granule.Codegen.NormalisedDef
      Language.Granule.Codegen.TopsortDefinitions
      Language.Granule.Codegen.ClosureFreeDef
      Language.Granule.Codegen.ConvertClosures
      Language.Granule.Codegen.Emit.EmitLLVM
      Language.Granule.Codegen.Compile
      Language.Granule.Codegen.MarkGlobals
  other-modules:
      Language.Granule.Codegen.Builtins.Builtins
      Language.Granule.Codegen.Builtins.Char
      Language.Granule.Codegen.Builtins.Extras
      Language.Granule.Codegen.Builtins.FloatArray
      Language.Granule.Codegen.Builtins.Ref
      Language.Granule.Codegen.Builtins.Session
      Language.Granule.Codegen.Builtins.Shared
      Language.Granule.Codegen.Builtins.String
      Language.Granule.Codegen.Builtins.Uniqueness
      Language.Granule.Codegen.Emit.EmitableDef
      Language.Granule.Codegen.Emit.EmitBuiltins
      Language.Granule.Codegen.Emit.EmitterState
      Language.Granule.Codegen.Emit.LLVMHelpers
      Language.Granule.Codegen.Emit.LowerClosure
      Language.Granule.Codegen.Emit.LowerExpression
      Language.Granule.Codegen.Emit.LowerOperator
      Language.Granule.Codegen.Emit.LowerPatterns
      Language.Granule.Codegen.Emit.LowerType
      Language.Granule.Codegen.Emit.MainOut
      Language.Granule.Codegen.Emit.MkId
      Language.Granule.Codegen.Emit.Names
      Language.Granule.Codegen.Emit.Primitives
      Language.Granule.Codegen.Emit.Types
      Language.Granule.Codegen.Monomorphise
      Language.Granule.Codegen.RewriteAST
      Language.Granule.Codegen.SubstituteTypes
      Paths_granule_compiler
  hs-source-dirs:
      src
  build-depends:
    , containers
    , llvm-hs ==12.*
    , llvm-hs-pure ==12.*
    , mtl
    , process
    , text

executable grlc
  import: shared
  main-is: Main.hs
  other-modules:
      Paths_granule_compiler
  hs-source-dirs:
      app
  build-depends:
      Glob
    , directory
    , extra
    , filepath
    , gitrev
    , granule-compiler
    , llvm-hs ==12.*
    , llvm-hs-pure ==12.*
    , optparse-applicative
    , process
    , text

test-suite compiler-spec
  import: shared
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Language.Granule.Codegen.BuildAST
      Language.Granule.Codegen.ConvertClosuresSpec
      Language.Granule.Codegen.NormalisedDefSpec
      Language.Granule.Codegen.TopsortDefinitionsSpec
      Paths_granule_compiler
  hs-source-dirs:
      tests/hspec
  build-depends:
      QuickCheck
    , directory
    , filemanip
    , granule-compiler
    , hspec
    , mtl
    , process
    , transformers >=0.5

test-suite golden
  import: shared
  type: exitcode-stdio-1.0
  main-is: Golden.hs
  other-modules:
      Paths_granule_compiler
  hs-source-dirs:
      tests/golden
  build-depends:
      directory
    , filepath
    , granule-compiler
    , llvm-hs ==12.*
    , llvm-hs-pure ==12.*
    , process
    , string-conversions
    , tasty
    , tasty-golden
    , text
